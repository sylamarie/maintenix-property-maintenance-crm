NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string.
# Use a Neon connection string with SSL enabled in production.
# Example Neon URLs usually include ?sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maintenix
DATABASE_CONNECTION_TIMEOUT_MS=5000

# JWT authentication.
# JWT_SECRET signs every login token, so there is deliberately no default: the
# API will not start until you fill it in with a random value of 32+ characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Local uploads directory for MVP job and variation photos.
UPLOAD_DIR=uploads

# One-click demo sign-in (no password) for the three demo accounts.
# Leave false on any real deployment. Set true only on a public portfolio demo.
DEMO_LOGIN_ENABLED=false
